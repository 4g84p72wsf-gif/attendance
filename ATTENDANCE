<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Class Attendance</title>
<style>
:root{--bg:#f6f4ee;--ink:#1d2b24;--muted:#64726b;--card:#fff;--line:#dcd8cb;--green:#1f5d46;--green-soft:#dcefe5;--red:#a6322c;--red-soft:#f8e1de;--hl:#ffe27a}
@media (prefers-color-scheme:dark){:root{--bg:#161d19;--ink:#eef2ee;--muted:#9aaaa1;--card:#1f2823;--line:#33413a;--green:#6fcf9f;--green-soft:#1f3a2e;--red:#ff8d84;--red-soft:#432522;--hl:#6b5a14}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 Georgia,"Times New Roman",serif;padding:16px;max-width:560px;margin:auto}
h1{font-size:1.7rem;margin:12px 0 2px;letter-spacing:-.01em}
h2{font-size:1.1rem;margin:0 0 8px}
.sub{color:var(--muted);margin:0 0 16px;font-family:system-ui,sans-serif;font-size:.9rem}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-bottom:14px}
input,textarea,button,select{font:inherit;font-family:system-ui,sans-serif}
input[type=text],input[type=password],input[type=date],textarea{width:100%;padding:12px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink);font-size:1rem}
textarea{min-height:130px;resize:vertical}
:focus-visible{outline:3px solid var(--hl);outline-offset:1px}
.btn{padding:12px 16px;border:0;border-radius:10px;background:var(--green);color:#fff;font-size:1rem;cursor:pointer;width:100%;margin-top:10px}
@media (prefers-color-scheme:dark){.btn{color:#0e1a14}}
.btn.alt{background:transparent;color:var(--ink);border:1px solid var(--line)}
.row{display:flex;gap:8px}.row>*{flex:1}
.msg{margin-top:12px;padding:12px;border-radius:10px;font-family:system-ui,sans-serif;font-size:.95rem}
.msg.ok{background:var(--green-soft);color:var(--green)}.msg.bad{background:var(--red-soft);color:var(--red)}
.stats{display:flex;gap:8px;margin-bottom:12px;font-family:system-ui,sans-serif}
.stat{flex:1;border-radius:10px;padding:10px;text-align:center;font-size:.85rem}
.stat b{display:block;font-size:1.6rem;font-family:Georgia,serif}
.stat.p{background:var(--green-soft);color:var(--green)}.stat.a{background:var(--red-soft);color:var(--red)}.stat.t{background:var(--card);border:1px solid var(--line)}
ul{list-style:none;margin:0;padding:0}
li{display:flex;align-items:center;gap:8px;padding:9px 0;border-bottom:1px solid var(--line);font-family:system-ui,sans-serif}
li:last-child{border:0}
li .n{flex:1}
.tag{font-size:.78rem;padding:3px 9px;border-radius:99px}
.tag.p{background:var(--green-soft);color:var(--green)}.tag.a{background:var(--red-soft);color:var(--red)}
.mini{border:1px solid var(--line);background:transparent;color:var(--ink);border-radius:8px;padding:5px 9px;font-size:.8rem;cursor:pointer}
.filters{display:flex;gap:6px;margin:6px 0 10px;font-family:system-ui,sans-serif}
.filters button{flex:1;padding:7px;border:1px solid var(--line);background:transparent;color:var(--ink);border-radius:8px;cursor:pointer;font-size:.85rem}
.filters button[aria-pressed=true]{background:var(--hl);border-color:var(--hl);color:#222}
.hidden{display:none}
.small{font-size:.82rem;color:var(--muted);font-family:system-ui,sans-serif;margin:8px 0 0}
</style>
</head>
<body>
<h1>Class Attendance</h1>
<p class="sub" id="today"></p>

<!-- STUDENT -->
<section id="stu">
  <div class="card">
    <h2>Type your full name</h2>
    <input type="text" id="name" list="names" placeholder="e.g. Juan Dela Cruz" autocomplete="off">
    <datalist id="names"></datalist>
    <button class="btn" id="mark">Mark me present</button>
    <div id="stuMsg" class="msg hidden" role="status"></div>
  </div>
</section>

<!-- ADMIN -->
<section id="adm" class="hidden">
  <div class="card" id="login">
    <h2 id="loginTitle">Admin login</h2>
    <input type="password" id="pin" placeholder="PIN" inputmode="numeric">
    <button class="btn" id="enter">Enter</button>
    <div id="loginMsg" class="msg bad hidden">Wrong PIN. Try again.</div>
    <p class="small hidden" id="setupNote">First time here: choose a PIN (at least 4 characters). You will use it every time you open the admin page.</p>
  </div>

  <div id="panel" class="hidden">
    <div class="card">
      <h2>Attendance for</h2>
      <input type="date" id="date">
      <div class="stats" style="margin-top:12px">
        <div class="stat t"><b id="sT">0</b>Total</div>
        <div class="stat p"><b id="sP">0</b>Present</div>
        <div class="stat a"><b id="sA">0</b>Absent</div>
      </div>
      <div class="filters" id="filters">
        <button data-f="all" aria-pressed="true">All</button>
        <button data-f="absent" aria-pressed="false">Absent</button>
        <button data-f="present" aria-pressed="false">Present</button>
      </div>
      <ul id="list"></ul>
      <div class="row" style="margin-top:10px">
        <button class="btn alt" id="csv">Download CSV</button>
        <button class="btn alt" id="clear">Reset this date</button>
      </div>
    </div>

    <div class="card">
      <h2>Class list</h2>
      <textarea id="roster" placeholder="One name per line"></textarea>
      <button class="btn" id="saveRoster">Save class list</button>
      <div id="rosterMsg" class="msg ok hidden"></div>
    </div>

    <div class="card">
      <h2>Change PIN</h2>
      <input type="password" id="newPin" placeholder="New PIN" inputmode="numeric">
      <button class="btn alt" id="savePin">Save PIN</button>
      <button class="btn alt" id="logout">Log out</button>
    </div>
  </div>
</section>

<script>
(function(){
  var K = {roster:'att_roster', pin:'att_pin', data:'att_data'};
  function load(k, d){ try{ var v = localStorage.getItem(k); return v ? JSON.parse(v) : d; }catch(e){ return d; } }
  function save(k, v){ try{ localStorage.setItem(k, JSON.stringify(v)); }catch(e){ alert('Could not save. Check that browser storage is allowed.'); } }
  var $ = function(id){ return document.getElementById(id); };
  function norm(s){ return s.toLowerCase().replace(/\s+/g,' ').replace(/[.,]/g,'').trim(); }
  function todayStr(){ var d = new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
  function esc(s){ return s.replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }

  var roster = load(K.roster, []);
  var pin = load(K.pin, null);
  var data = load(K.data, {});   // { 'YYYY-MM-DD': { 'Name': 'time' } }
  var filter = 'all';
  var adminDate = todayStr();

  $('today').textContent = new Date().toLocaleDateString(undefined,{weekday:'long',year:'numeric',month:'long',day:'numeric'});

  function fillDatalist(){
    $('names').innerHTML = roster.map(function(n){ return '<option value="'+esc(n)+'">'; }).join('');
  }

  // The admin page is not linked anywhere. Open it by adding #admin to the address.
  function route(){
    var isAdmin = location.hash === '#admin';
    $('stu').classList.toggle('hidden', isAdmin);
    $('adm').classList.toggle('hidden', !isAdmin);
    if(!isAdmin){ $('panel').classList.add('hidden'); $('login').classList.remove('hidden'); }
    else {
      $('loginTitle').textContent = pin ? 'Admin login' : 'Create your admin PIN';
      $('enter').textContent = pin ? 'Enter' : 'Save PIN and enter';
      $('setupNote').classList.toggle('hidden', !!pin);
    }
  }
  window.addEventListener('hashchange', route);

  // Student: mark present
  function msg(text, ok){
    var m = $('stuMsg'); m.textContent = text; m.className = 'msg ' + (ok ? 'ok' : 'bad');
  }
  function mark(){
    var typed = $('name').value;
    if(!norm(typed)){ msg('Please type your name first.', false); return; }
    if(!roster.length){ msg('The class list is empty. Ask your admin to add it.', false); return; }
    var match = roster.filter(function(n){ return norm(n) === norm(typed); })[0];
    if(!match){ msg('We could not find that name. Check your spelling or ask your admin.', false); return; }
    var day = todayStr();
    data[day] = data[day] || {};
    if(data[day][match]){ msg(match + ', you are already marked present (' + data[day][match] + ').', true); return; }
    data[day][match] = new Date().toLocaleTimeString([], {hour:'numeric', minute:'2-digit'});
    save(K.data, data);
    msg('Thanks, ' + match + '! You are marked present at ' + data[day][match] + '.', true);
    $('name').value = '';
  }
  $('mark').onclick = mark;
  $('name').addEventListener('keydown', function(e){ if(e.key === 'Enter') mark(); });

  // Admin: login
  function enter(){
    if(!pin){
      var np = $('pin').value.trim();
      if(np.length < 4){ $('loginMsg').textContent = 'Use at least 4 characters.'; $('loginMsg').classList.remove('hidden'); return; }
      pin = np; save(K.pin, pin); $('loginMsg').textContent = 'Wrong PIN. Try again.';
      $('pin').value = ''; $('loginMsg').classList.add('hidden');
      $('panel').classList.remove('hidden'); $('login').classList.add('hidden');
      $('roster').value = roster.join('\n'); $('date').value = adminDate; render(); return;
    }
    if($('pin').value === pin){
      $('login').classList.add('hidden'); $('panel').classList.remove('hidden');
      $('loginMsg').classList.add('hidden'); $('pin').value = '';
      $('roster').value = roster.join('\n');
      $('date').value = adminDate;
      render();
    } else { $('loginMsg').classList.remove('hidden'); }
  }
  $('enter').onclick = enter;
  $('pin').addEventListener('keydown', function(e){ if(e.key === 'Enter') enter(); });
  $('logout').onclick = function(){ location.hash = ''; route(); };

  // Admin: render list
  function render(){
    var day = data[adminDate] || {};
    var present = roster.filter(function(n){ return day[n]; }).length;
    $('sT').textContent = roster.length; $('sP').textContent = present; $('sA').textContent = roster.length - present;
    var rows = roster.filter(function(n){
      return filter === 'all' || (filter === 'present' ? day[n] : !day[n]);
    });
    if(!roster.length){ $('list').innerHTML = '<li class="n">No names yet. Add your class list below.</li>'; return; }
    if(!rows.length){ $('list').innerHTML = '<li class="n">Nobody here.</li>'; return; }
    $('list').innerHTML = rows.map(function(n){
      var p = !!day[n];
      return '<li><span class="n">'+esc(n)+'</span>'+
        '<span class="tag '+(p?'p':'a')+'">'+(p ? 'Present '+esc(day[n]) : 'Absent')+'</span>'+
        '<button class="mini" data-n="'+esc(n)+'">'+(p?'Undo':'Mark present')+'</button></li>';
    }).join('');
  }
  $('list').addEventListener('click', function(e){
    var b = e.target.closest('button[data-n]'); if(!b) return;
    var n = b.getAttribute('data-n');
    data[adminDate] = data[adminDate] || {};
    if(data[adminDate][n]) delete data[adminDate][n];
    else data[adminDate][n] = 'by admin';
    save(K.data, data); render();
  });
  $('filters').addEventListener('click', function(e){
    var b = e.target.closest('button[data-f]'); if(!b) return;
    filter = b.getAttribute('data-f');
    Array.prototype.forEach.call($('filters').children, function(x){ x.setAttribute('aria-pressed', x === b); });
    render();
  });
  $('date').onchange = function(){ adminDate = $('date').value || todayStr(); render(); };

  // Admin: roster
  $('saveRoster').onclick = function(){
    var seen = {}, out = [];
    $('roster').value.split('\n').forEach(function(l){
      var n = l.replace(/\s+/g,' ').trim(); if(!n) return;
      if(!seen[norm(n)]){ seen[norm(n)] = 1; out.push(n); }
    });
    roster = out; save(K.roster, roster); fillDatalist(); render();
    var m = $('rosterMsg'); m.textContent = 'Saved ' + out.length + ' names.'; m.classList.remove('hidden');
  };

  // Admin: reset date, PIN, CSV
  $('clear').onclick = function(){
    if(confirm('Clear all attendance for ' + adminDate + '?')){ delete data[adminDate]; save(K.data, data); render(); }
  };
  $('savePin').onclick = function(){
    var v = $('newPin').value.trim();
    if(v.length < 4){ alert('Use at least 4 characters.'); return; }
    pin = v; save(K.pin, pin); $('newPin').value = ''; alert('PIN changed.');
  };
  $('csv').onclick = function(){
    var day = data[adminDate] || {};
    var lines = ['Name,Status,Time'].concat(roster.map(function(n){
      return '"'+n.replace(/"/g,'""')+'",'+(day[n] ? 'Present' : 'Absent')+','+(day[n] || '');
    }));
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([lines.join('\n')], {type:'text/csv'}));
    a.download = 'attendance-' + adminDate + '.csv'; a.click();
  };

  fillDatalist();
  route();
})();
</script>
</body>
</html>
